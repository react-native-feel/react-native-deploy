# Copy to .env and fill in your MacinCloud credentials.
# .env is gitignored — never commit this file with real values.

# From MacinCloud welcome email
MAC_VNC_HOST=TX0XX.macincloud.com
MAC_VNC_USER=userXXXXXX
MAC_VNC_PASSWORD=your-mac-password

# Usually 22. If MacinCloud assigned a non-standard SSH port, put it here.
MAC_VNC_SSH_PORT=22

# On MacinCloud managed plans this is typically the same as MAC_VNC_PASSWORD.
# If the account instructions list a separate Screen Sharing password, use that.
MAC_VNC_VNC_PASSWORD=your-vnc-password

# Optional: simulator device/runtime
# Tip: run `xcrun simctl list devices` over SSH to see what's pre-created on your Mac.
# Xcode 26.x ships iPhone 17 series — "iPhone 16 Pro" won't exist.
MAC_VNC_DEVICE="iPhone 17 Pro"
# MAC_VNC_RUNTIME=

# Used only by bin/baguette.sh — port baguette serves the web UI on (default 8421).
# MAC_VNC_BAGUETTE_PORT=8421
