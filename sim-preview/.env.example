# Copy to .env and fill in your remote Mac credentials.
# .env is gitignored — never commit this file with real values.
#
# Canonical prefix is RN_PREVIEW_. The older MAC_VNC_ spelling of every variable
# below is still accepted, so an existing .env keeps working untouched.

# From your MacinCloud welcome email (or any Mac you can SSH into)
RN_PREVIEW_HOST=TX0XX.macincloud.com
RN_PREVIEW_USER=userXXXXXX
RN_PREVIEW_PASSWORD=your-mac-password

# Usually 22. If MacinCloud assigned a non-standard SSH port, put it here.
RN_PREVIEW_SSH_PORT=22

# Optional: simulator device/runtime
# Tip: run `xcrun simctl list devices` over SSH to see what's pre-created on your Mac.
# Xcode 26.x ships iPhone 17 series — "iPhone 16 Pro" won't exist.
RN_PREVIEW_DEVICE="iPhone 17 Pro"
# RN_PREVIEW_RUNTIME=

# --- baguette flow (bin/baguette.sh, bin/tunnel.sh) ---
# Port baguette serves the web UI on, remote and local ends of the tunnel.
# RN_PREVIEW_BAGUETTE_PORT=8421

# --- legacy VNC flow only (bin/connect.sh) ---
# On MacinCloud managed plans this is typically the same as RN_PREVIEW_PASSWORD.
# If the account instructions list a separate Screen Sharing password, use that.
RN_PREVIEW_VNC_PASSWORD=your-vnc-password
