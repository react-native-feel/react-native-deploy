// react-native-deploy.pages.dev — the dashboard, the docs and the public install
// pages, deployed as one Cloudflare Pages project.
//
// `npm run deploy` builds the dashboard into .pages-dist/deploy/dashboard and the
// docs into .pages-dist/deploy/docs, adds .pages-dist/_worker.js (which re-exports
// worker/index.js — Pages "advanced mode", so every request reaches it), and runs
// `wrangler pages deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "react-native-deploy",
  "pages_build_output_dir": "./.pages-dist",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "BUILDS",
      "bucket_name": "rn-eas-builds"
    }
  ]
  // UPLOAD_TOKEN is a secret:
  //   npx wrangler pages secret put UPLOAD_TOKEN --project-name react-native-deploy
}
