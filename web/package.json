{
  "name": "rn-eas-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:worker": "vite build --outDir .worker-assets/deploy/dashboard --emptyOutDir",
    "deploy": "npm run build:worker && npm run build:docs && wrangler deploy",
    "build:docs": "npm --prefix ../docs-site run build && rm -rf .worker-assets/deploy/docs && cp -R ../docs-site/.vitepress/dist .worker-assets/deploy/docs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.145.0"
  }
}
