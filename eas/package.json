{
  "name": "@react-native-feel/deploy",
  "version": "0.1.0",
  "description": "React Native Deploy: the eas build/submit commands and your eas.json, with builds running on GitHub Actions runners and store delivery handled by the asc CLI.",
  "type": "module",
  "bin": {
    "rnd": "./dist/bin/rnd.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidah/react-native-deploy.git",
    "directory": "eas"
  },
  "homepage": "https://react-native-deploy.pages.dev/deploy/docs/",
  "keywords": [
    "react-native",
    "expo",
    "eas",
    "github-actions",
    "testflight",
    "ios",
    "android"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@babel/code-frame": "^7.26.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "env-string": "^1.0.1",
    "golden-fleece": "^1.0.9",
    "joi": "^17.13.3",
    "libsodium-wrappers": "^0.7.15",
    "semver": "^7.6.3"
  },
  "license": "ISC",
  "devDependencies": {
    "@expo/eas-json": "^24.5.0",
    "eas-cli": "^24.6.0",
    "esbuild": "^0.28.2"
  }
}
