# E2E smoke-test credentials. Copy to credentials.env and fill in.
# credentials.env is gitignored — never commit real values.

# ---- MacinCloud build host (replaces AWS EC2 Mac for the E2E) --------------
# These can mirror aws-mac-vnc/.env if you've already filled that in.
MAC_HOST=TX0XX.macincloud.com
MAC_PORT=22
MAC_USER=userXXXXXX
MAC_PASSWORD=
# Working directory on the Mac for the build (clone target, artifacts, etc).
MAC_WORK_DIR=~/rn-deploy-e2e

# ---- Cloudflare R2 (OTA artifact storage) ----------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=rn-deploy-e2e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL — custom domain or https://pub-<hash>.r2.dev
R2_PUBLIC_BASE_URL=

# ---- App Store Connect API key (ad-hoc signing) ----------------------------
# Drop the .p8 inside .e2e/ — .gitignore already excludes *.p8.
ASC_KEY_PATH=.e2e/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# ---- Apple Developer -------------------------------------------------------
APPLE_TEAM_ID=
# Bundle ID for the smoke app — must be registerable under the team above.
SMOKE_BUNDLE_ID=com.bidah.rndeploy.smoke
# Device UDID registered on the dev account for ad-hoc install.
# Leave blank to skip the on-device install assertion (the test will just
# verify the IPA URL returns 200).
TEST_DEVICE_UDID=

# ---- Throwaway GitHub repo the smoke app is force-pushed to ----------------
# Format: https://github.com/<owner>/<repo>.git  (must be reachable from the
# MacinCloud host — public is simplest; private needs a deploy key on the Mac).
# Same repo is reused for the GHA E2E case (it holds the workflow file).
SMOKE_REPO_URL=
SMOKE_REPO_BRANCH=main
# owner/name form (used by gh CLI to dispatch + poll the workflow).
SMOKE_REPO_SLUG=

# ---- GitHub Actions E2E (only needed for the GHA test case) ----------------
# Filename of the workflow YAML inside .github/workflows/ in the smoke repo.
GHA_WORKFLOW_FILE=rn-deploy.yml
# A PAT with `repo` + `workflow` scopes, OR rely on `gh auth status` already
# being logged in to an account with access. Leave blank to use the gh CLI.
GH_TOKEN=
# The ASC + R2 creds above must ALSO be configured as repo secrets in the
# smoke repo (the workflow reads them via secrets.*). Run once:
#   gh secret set ASC_KEY     --repo $SMOKE_REPO_SLUG < $ASC_KEY_PATH
#   gh secret set ASC_KEY_ID  --repo $SMOKE_REPO_SLUG --body "$ASC_KEY_ID"
#   gh secret set ASC_ISSUER_ID --repo $SMOKE_REPO_SLUG --body "$ASC_ISSUER_ID"
#   gh secret set R2_ACCESS_KEY_ID --repo $SMOKE_REPO_SLUG --body "$R2_ACCESS_KEY_ID"
#   gh secret set R2_SECRET_ACCESS_KEY --repo $SMOKE_REPO_SLUG --body "$R2_SECRET_ACCESS_KEY"
