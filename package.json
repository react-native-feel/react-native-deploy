{
  "name": "rn-deploy",
  "version": "1.0.0",
  "type": "module",
  "description": "Build React Native iOS apps on a remote Mac and deploy to TestFlight or via OTA.",
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "testflight",
    "app-store",
    "ota",
    "ci",
    "deploy",
    "ec2-mac",
    "macincloud",
    "cua",
    "baguette"
  ],
  "author": "Rodrigo Figueroa (https://github.com/bidah)",
  "license": "MIT",
  "homepage": "https://github.com/bidah/react-native-deploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidah/react-native-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/bidah/react-native-deploy/issues"
  },
  "bin": {
    "rn-deploy": "./bin/rn-deploy.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "test:e2e": "RN_DEPLOY_E2E=1 bash -c 'source .e2e/load-env.sh 2>/dev/null; node --test test/e2e/*.test.js'"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.0",
    "node-ssh": "^13.2.1",
    "ora": "^9.3.0",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "@trycua/computer": "^0.1.6"
  }
}
