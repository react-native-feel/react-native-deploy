{
  "cli": {
    "version": "1.0.0"
  },
  "host": {
    "kind": "aws"
  },
  "_host_example_macincloud_": {
    "kind": "macincloud",
    "host": "TX0XX.macincloud.com",
    "port": 22,
    "user": "userXXXXXX",
    "password": "${MAC_PASSWORD}",
    "workDir": "~/rn-deploy-work",
    "_comment": "Use \"privateKey\" instead of \"password\" for key auth. Values like ${MAC_PASSWORD} are read from the environment at load time so secrets stay out of git."
  },
  "_host_example_github_actions_": {
    "kind": "github-actions",
    "repo": "owner/name",
    "workflow": "rn-deploy.yml",
    "ref": "main",
    "_comment": "Builds run on a macOS runner. Copy templates/github/rn-deploy.yml into .github/workflows/ and set R2 secrets on the repo. Currently supports distribution: simulator."
  },
  "aws": {
    "region": "us-east-1",
    "instanceType": "mac2.metal",
    "keyPairName": "rn-deploy-key",
    "securityGroupName": "rn-deploy-sg",
    "customAmiId": null,
    "nodeVersion": "20",
    "xcodeVersion": "16"
  },
  "signing": {
    "bundleId": null,
    "profileType": "IOS_APP_STORE",
    "createMissing": true,
    "syncRepo": null
  },
  "storage": null,
  "_storage_example_r2_": {
    "kind": "r2",
    "accountId": "<cloudflare-account-id>",
    "bucket": "rn-deploy-artifacts",
    "accessKeyId": "<R2_ACCESS_KEY_ID>",
    "secretAccessKey": "<R2_SECRET_ACCESS_KEY>",
    "publicBaseUrl": "https://artifacts.example.com"
  },
  "repo": {
    "url": "",
    "branch": "main"
  },
  "build": {
    "production": {
      "buildType": "expo",
      "scheme": "MyApp",
      "buildConfiguration": "Release",
      "distribution": "app-store",
      "env": {}
    },
    "preview": {
      "extends": "production",
      "distribution": "ad-hoc"
    },
    "development": {
      "extends": "production",
      "buildConfiguration": "Debug",
      "distribution": "development"
    }
  },
  "submit": {
    "production": {
      "ascAppId": null,
      "testFlightGroups": ["Internal Testers"],
      "whatToTest": ""
    }
  }
}
